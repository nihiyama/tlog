{
  "name": "vscode-tlog",
  "displayName": "TLog Test Manager",
  "publisher": "nihiyama",
  "version": "0.4.0",
  "private": true,
  "description": "tlog VS Code extension",
  "icon": "media/icon.png",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/nihiyama/tlog.git",
    "directory": "packages/vscode-extension"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tlog",
          "title": "TLog",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "tlog": [
        {
          "id": "tlog.controls",
          "name": "%views.controls%",
          "type": "webview"
        },
        {
          "id": "tlog.tree",
          "name": "%views.suites%"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "tlog.manager",
        "displayName": "%customEditors.manager%",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "tlog.selectRoot",
        "title": "%commands.selectRoot%",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "tlog.searchTags",
        "title": "%commands.searchTags%",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "tlog.searchOwners",
        "title": "%commands.searchOwners%",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "tlog.clearSearch",
        "title": "%commands.clearSearch%",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "tlog.openManager",
        "title": "%commands.openManager%",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "tlog.refreshTree",
        "title": "%commands.refreshTree%",
        "icon": {
          "light": "media/sidebar-icon.svg",
          "dark": "media/sidebar-icon.svg"
        }
      },
      {
        "command": "tlog.createSuite",
        "title": "%commands.createSuite%",
        "icon": {
          "light": "media/new-folder.svg",
          "dark": "media/new-folder.svg"
        }
      },
      {
        "command": "tlog.createCase",
        "title": "%commands.createCase%",
        "icon": {
          "light": "media/new-file.svg",
          "dark": "media/new-file.svg"
        }
      },
      {
        "command": "tlog.filterCases",
        "title": "%commands.filterCases%"
      },
      {
        "command": "tlog.showSuiteStats",
        "title": "%commands.showSuiteStats%"
      },
      {
        "command": "tlog.openRelated",
        "title": "%commands.openRelated%"
      },
      {
        "command": "tlog.openRawYaml",
        "title": "%commands.openRawYaml%"
      },
      {
        "command": "tlog.deleteNode",
        "title": "%commands.deleteNode%"
      },
      {
        "command": "tlog.expandAllSuites",
        "title": "%commands.expandAllSuites%",
        "icon": {
          "light": "media/chevrons-down.svg",
          "dark": "media/chevrons-down.svg"
        }
      },
      {
        "command": "tlog.collapseAllSuites",
        "title": "%commands.collapseAllSuites%",
        "icon": {
          "light": "media/chevrons-up.svg",
          "dark": "media/chevrons-up.svg"
        }
      }
    ],
    "configuration": [
      {
        "title": "TLog",
        "properties": {
          "tlog.scopeMode": {
            "type": "string",
            "enum": [
              "recursive",
              "currentOnly"
            ],
            "default": "recursive",
            "description": "%configuration.scopeMode.description%"
          }
        }
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "tlog.createSuite",
          "when": "view == tlog.tree && viewItem == suite",
          "group": "inline@1"
        },
        {
          "command": "tlog.createCase",
          "when": "view == tlog.tree && viewItem == suite",
          "group": "inline@2"
        },
        {
          "command": "tlog.openManager",
          "when": "view == tlog.tree && (viewItem == suite || viewItem == case)",
          "group": "navigation@1"
        },
        {
          "command": "tlog.openRawYaml",
          "when": "view == tlog.tree && (viewItem == suite || viewItem == case)",
          "group": "navigation@2"
        },
        {
          "command": "tlog.deleteNode",
          "when": "view == tlog.tree && (viewItem == suite || viewItem == case)",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "tlog.expandAllSuites",
          "when": "view == tlog.tree",
          "group": "navigation@10"
        },
        {
          "command": "tlog.collapseAllSuites",
          "when": "view == tlog.tree",
          "group": "navigation@11"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.cjs --external:vscode",
    "watch": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "package:vsix": "npm run build && vsce package --no-dependencies --baseContentUrl https://raw.githubusercontent.com/nihiyama/tlog/main/packages/vscode-extension --baseImagesUrl https://raw.githubusercontent.com/nihiyama/tlog/main/packages/vscode-extension",
    "publish:marketplace": "vsce publish --no-dependencies --baseContentUrl https://raw.githubusercontent.com/nihiyama/tlog/main/packages/vscode-extension --baseImagesUrl https://raw.githubusercontent.com/nihiyama/tlog/main/packages/vscode-extension",
    "publish:precheck": "npm run typecheck && npm run test && npm run package:vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.27.3"
  },
  "dependencies": {
    "@tlog/shared": "0.3.1"
  }
}
